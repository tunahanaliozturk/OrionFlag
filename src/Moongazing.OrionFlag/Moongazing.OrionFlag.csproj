<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionFlag</PackageId>
    <Description>In-process feature flags with reloadable configuration, immutable per-request snapshots, OpenTelemetry, and deterministic subject-based percentage rollout. Boolean checks are lock-free and allocation-free; NativeAOT tested. No network call per check.</Description>
    <PackageTags>orion;feature-flags;feature-management;toggle;dynamic-config;dotnet</PackageTags>
    <RootNamespace>Moongazing.OrionFlag</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Orion.Abstractions" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionFlag.Tests" />
  </ItemGroup>
</Project>
